end

local function getRemainingSecondsToTransition()
    local isNight, timerText = getNightStatus()

    if isNight then
        if nextResetAt then
            return nextResetAt - Workspace:GetServerTimeNow()
        else
            return nil
        end
    else
        if timerText and timerText ~= "Siang" and timerText ~= "Mencari event..." then
            local hours, minutes, seconds = timerText:match("(%d+)%s*jam%s*(%d+)%s*mnt%s*(%d+)%s*dtk")
            if hours then
                return tonumber(hours)*3600 + tonumber(minutes)*60 + tonumber(seconds)
            end
            local m, s = timerText:match("(%d+)%s*mnt%s*(%d+)%s*dtk")
            if m then
                local total = tonumber(m)*60
                if s then total += tonumber(s) end
                return total
            end
            local secOnly = timerText:match("(%d+)%s*dtk")
            if secOnly then
                return tonumber(secOnly)
            end
            local mins2, secs2 = timerText:match("(%d+):(%d+)")
            if mins2 then
                return tonumber(mins2)*60 + tonumber(secs2)
            end
        end
        return nil
    end
end

local function getAreaEggSnapshot()
    if snapshotRemote and snapshotRemote:IsA("RemoteFunction") then
        local ok, result = pcall(function() return snapshotRemote:InvokeServer() end)
        if ok and result and result.Records then
            return result
        end
    end
    local fakeRecords = {}
    local folder = Workspace:FindFirstChild("AreaEggSlotsClient") or Workspace:FindFirstChild("AreaEggSlots")
    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") or model:IsA("BasePart") then
                local uid = model.Name
                local pos = model:IsA("Model") and model:GetPivot().Position or model.Position
                local area = getNearestArea(pos)
                local assetCategory = model:GetAttribute("AssetCategory") or uid
                table.insert(fakeRecords, {
                    Uid = uid,
                    AreaId = area and area.name or "Forest",
                    AssetCategory = assetCategory,
                    AssetScale = model:GetAttribute("AssetScale") or 1,
                    BottomCFrame = model:IsA("Model") and model:GetPivot() or CFrame.new(model.Position),
                })
            end
        end
    end
    return { Records = fakeRecords, ServerTime = os.time() }
end

local function isModelAllowed(assetCategory)
    local rarityName = getRarityName(assetCategory)
    local displayName = getDisplayName(assetCategory)

    local hasNameSelection = false
    for _, v in pairs(selectedEggNames) do
        if v == true then hasNameSelection = true break end
    end
    local hasRaritySelection = false
    for _, v in pairs(selectedRarities) do
        if v == true then hasRaritySelection = true break end
    end

    local nameMatch = false
    if hasNameSelection then
        local optionString = displayName .. " | " .. rarityName
        nameMatch = selectedEggNames[optionString] == true
    end

    local rarityMatch = true
    if hasRaritySelection then
        rarityMatch = selectedRarities[rarityName] == true
    end

    if hasNameSelection then
        if nameMatch then return true end
        return rarityMatch
    else
        return rarityMatch
    end
end

local function getIncomeForCategoryAndScale(category, scale)
    local baseIncome = AssetsDirectory[category] and AssetsDirectory[category].Income or 0
    local multiplier = scale and getSizeGrowthMultiplier(scale) or 1
    return baseIncome * multiplier
end

local function findEggsFromSnapshot()
    local snapshot = getAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil, {} end

    local foundArea = nil
    local foundModels = {}

    for _, record in ipairs(snapshot.Records) do
        local recordArea = record.AreaId
        local area = nil
        for _, a in ipairs(selectedAreasOrdered) do
            if a.name == recordArea then area = a break end
        end

        if area then
            local uid = record.Uid
            local model = nil
            local folder = Workspace:FindFirstChild("AreaEggSlotsClient")
            if folder then model = folder:FindFirstChild(uid) end
            if not model then model = Workspace:FindFirstChild(uid) end

            if model and (model:IsA("Model") or model:IsA("BasePart")) then
                local assetCategory = record.AssetCategory or model.Name
                if isModelAllowed(assetCategory) then
                    local scale = record.AssetScale or model:GetAttribute("AssetScale") or 1
                    local income = getIncomeForCategoryAndScale(assetCategory, scale)

                    if income >= minIncomeFilter and income <= maxIncomeFilter then
                        foundArea = area
                        table.insert(foundModels, model)
                    end
                end
            end
        end
    end
    return foundArea, foundModels
end

