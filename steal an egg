end

local function isNightFallback()
    local clock = Lighting.ClockTime
    local brightness = Lighting.Brightness
    local nightClockTime = 3.1
    local nightBrightness = 3
    local nearClock = math.abs(clock - nightClockTime) < 0.7
    local nearBrightness = (type(brightness) == "number") and math.abs(brightness - nightBrightness) < 0.2 or false
    return nearClock and nearBrightness
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then return string.format("%d jam %d mnt %d dtk", hours, minutes, secs)
    elseif minutes > 0 then return string.format("%d mnt %d dtk", minutes, secs)
    else return string.format("%d dtk", secs) end
end

local function getNightStatus()
    local now = Workspace:GetServerTimeNow()
    local isNight = false
    local timerText = "Mencari event..."
    local targetText = ""
    local demonic = Workspace:GetAttribute("Event_DemonicEvent") or false
    if nextResetAt and now < nextResetAt then
        isNight = true
        local remaining = nextResetAt - now
        timerText = formatTime(remaining)
        targetText = "Menuju: Siang ☀️"
        return isNight, timerText, targetText, demonic
    end
    local guiText = getGameResetTimerText() or getResetStartTimerText()
    if guiText then
        isNight = isNightFallback()
        timerText = guiText
        if isNight then targetText = "Menuju: Siang ☀️" else targetText = "Menuju: Malam 🌙" end
        return isNight, timerText, targetText, demonic
    end
    isNight = isNightFallback()
    if isNight then timerText = "Malam" targetText = "Menuju: Siang ☀️" else timerText = "Siang" targetText = "Menuju: Malam 🌙" end
    return isNight, timerText, targetText, demonic
end

local function isNightTime()
    local isNight = getNightStatus()
    return isNight
end

local function getRemainingSecondsToTransition()
    local isNight, timerText = getNightStatus()
    if isNight then
        if nextResetAt then return nextResetAt - Workspace:GetServerTimeNow() else return nil end
    else
        if timerText and timerText ~= "Siang" and timerText ~= "Mencari event..." then
            local hours, minutes, seconds = timerText:match("(%d+)%s*jam%s*(%d+)%s*mnt%s*(%d+)%s*dtk")
            if hours then
                local h = tonumber(hours) or 0
                local min = tonumber(minutes) or 0
                local sec = tonumber(seconds) or 0
                return h * 3600 + min * 60 + sec
            end
            local m, s = timerText:match("(%d+)%s*mnt%s*(%d+)%s*dtk")
            if m then
                local total = (tonumber(m) or 0) * 60
                if s then total = total + (tonumber(s) or 0) end
                return total
            end
            local secOnly = timerText:match("(%d+)%s*dtk")
            if secOnly then return tonumber(secOnly) or 0 end
            local mins2, secs2 = timerText:match("(%d+):(%d+)")
            if mins2 then return (tonumber(mins2) or 0) * 60 + (tonumber(secs2) or 0) end
        end
        return nil
    end
end

local function getAreaEggSnapshot()
