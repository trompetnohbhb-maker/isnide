local function espRefresh()
    local snapshot = getAreaEggSnapshot()
    if not snapshot or not snapshot.Records then
        if espStatusLabel then safeSetLabel(espStatusLabel, "Eggs: 0") end
        return
    end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        if espStatusLabel then safeSetLabel(espStatusLabel, "Eggs: 0") end
        return
    end
    local playerPos = char.HumanoidRootPart.Position
    local shown = 0
    local validUids = {}
    local folder = Workspace:FindFirstChild("AreaEggSlotsClient")
    for _, record in ipairs(snapshot.Records) do
        local pos = espGetEggPosition(record)
        if pos and (pos - playerPos).Magnitude <= espRenderDistance then
            local uid = record.Uid
            validUids[uid] = true
            local model = folder and folder:FindFirstChild(uid) or Workspace:FindFirstChild(uid)
            local scale = record.AssetScale or 1
            if model and model:IsA("Model") then
                local okScale, modelScale = pcall(function() return model:GetScale() end)
                if okScale and modelScale then scale = modelScale end
            end
            local category = record.AssetCategory or "Unknown"
            local displayName = getDisplayName(category)
            local rarityName = getRarityName(category)
            local color = getRarityColorByCategory(category)
            local mutations = record.Mutations or {}
            local income = getIncomeForCategoryScaleAndMutations(category, scale, mutations)
            local mutationText = ""
            if type(mutations) == "table" and #mutations > 0 then mutationText = table.concat(mutations, ", ") end
            local labelText = displayName
            if mutationText ~= "" then labelText = labelText .. " [" .. mutationText .. "]" end
            labelText = labelText .. "\n" .. rarityName .. " | $" .. formatCompact(income) .. "/s | x" .. formatScale(scale)
            local existing = espBillboards[uid]
            if existing then
                if existing.anchorPart then existing.anchorPart.CFrame = CFrame.new(pos) end
                local textLabel = existing.billboard:FindFirstChildOfClass("TextLabel")
                if textLabel then
                    if textLabel.Text ~= labelText then textLabel.Text = labelText end
                    if textLabel.TextColor3 ~= color then textLabel.TextColor3 = color end
                end
            else
                local anchor = Instance.new("Part")
                anchor.Name = "ESPAnchor_" .. uid
                anchor.Anchored = true
                anchor.CanCollide = false
                anchor.CanQuery = false
                anchor.CanTouch = false
                anchor.Transparency = 1
                anchor.Size = Vector3.new(0.1, 0.1, 0.1)
                anchor.CFrame = CFrame.new(pos)
                anchor.Parent = Workspace
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "EggESP"
                billboard.AlwaysOnTop = true
                billboard.Size = UDim2.fromOffset(220, 50)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.MaxDistance = espRenderDistance
                billboard.Adornee = anchor
                billboard.Parent = anchor
                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.fromScale(1, 1)
                textLabel.BackgroundTransparency = 1
                textLabel.Font = Enum.Font.GothamBold
                textLabel.Text = labelText
                textLabel.TextColor3 = color
                textLabel.TextStrokeTransparency = 0
                textLabel.TextSize = 14
                textLabel.TextWrapped = true
                textLabel.TextYAlignment = Enum.TextYAlignment.Center
                textLabel.Parent = billboard
                espBillboards[uid] = { billboard = billboard, anchorPart = anchor }
            end
            shown = shown + 1
        end
    end
    for uid, data in pairs(espBillboards) do
        if not validUids[uid] then
            pcall(function() data.billboard:Destroy() end)
            if data.anchorPart then pcall(function() data.anchorPart:Destroy() end) end
            espBillboards[uid] = nil
        end
    end
    if espStatusLabel then safeSetLabel(espStatusLabel, "Eggs: " .. shown) end
end

