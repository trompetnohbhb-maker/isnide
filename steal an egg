    local fireServerFunc = Instance.new("RemoteEvent").FireServer
    oldFireServer = hookfunction(fireServerFunc, function(self, ...)
        local args = table.pack(...)
        if deathHandlerActive and (self.Name:lower():find("requestcharacterreset") or self.Name:lower():find("clientcharacter")) then
            return
        end
        return oldFireServer(self, table.unpack(args, 1, args.n))
    end)
end

