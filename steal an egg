local function startFarm()
    if farmActive then return end
    if #selectedAreasOrdered == 0 then return end
    farmActive = true
    setAntiRagdoll(true)
    enableGodMode()
    toggleDeathHandler(true)
    local rootPart = getRootPart()
    if rootPart then
        local startPos = getNearestStartPos(rootPart.Position)
        rootPart.CFrame = CFrame.new(startPos)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    wait(0.5)
    farmLoop = task.spawn(function()
        local waitedForDay = false
        while farmActive do
            local isNight = isNightTime()
            if isNight then
                waitedForDay = true
                while farmActive and isNightTime() do task.wait(0.5) end
                task.wait(4)
                waitedForDay = false
            else
                if waitedForDay then
                    task.wait(4)
                    waitedForDay = false
                end
                local remaining = getRemainingSecondsToTransition()
                if remaining and remaining <= 15 then
                    local safePos = getNearestSafePos(getRootPart() and getRootPart().Position or SAFE_POS_1)
                    flyToTarget(safePos, true)
                    wait(0.5)
                    while farmActive and isNightTime() do task.wait(0.5) end
                    task.wait(4)
                    waitedForDay = false
                end
                local targetArea, models = findEggsFromSnapshot()
                if targetArea and #models > 0 then
                    local targetModel = models[math.random(1, #models)]
                    local targetUid = targetModel.Name
                    local targetPos = targetModel:IsA("Model") and targetModel:GetPivot().Position or targetModel.Position
                    local flySuccess = flyToTarget(targetPos, false)
                    if not farmActive then break end
                    if not flySuccess and isNightTime() then
                        while farmActive and isNightTime() do task.wait(0.5) end
                        task.wait(4)
                        waitedForDay = false
                    elseif flySuccess and farmActive then
                        task.wait(0.2)
                        if carryRemote then
                            startCarrySpam(targetUid)
                            local safePos = getNearestSafePos(getRootPart() and getRootPart().Position or SAFE_POS_1)
                            flyToTarget(safePos, true)
                            stopCarrySpam()
                            wait(farmDelay)
                        else
                            stopFarm()
                            break
                        end
                    else
                        wait(0.5)
                    end
                else
                    wait(1)
                end
            end
            if not farmActive then break end
        end
        disableGodMode()
        toggleDeathHandler(false)
    end)
end

