local flySpeed = 100

local function flyToTarget(targetPos, landOnArrival)
    local rootPart = getRootPart()
    local humanoid = getHumanoid()
    if not rootPart or not humanoid or not rootPart.Parent then return false end
    humanoid.PlatformStand = true
    local targetY = targetPos.Y + 10
    local actualTarget = Vector3.new(targetPos.X, targetY, targetPos.Z)
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    bodyGyro.P = 10000
    bodyGyro.D = 100
    bodyGyro.CFrame = CFrame.lookAt(rootPart.Position, actualTarget)
    bodyGyro.Parent = rootPart
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Velocity = Vector3.new(0, 0, 0)
    bodyVel.Parent = rootPart
    local arrived = false
    local startTime = tick()
    while not arrived and (tick() - startTime) < 60 do
        if not rootPart.Parent then break end
        if isNightTime() then break end
        local pos = rootPart.Position
        local dir = (actualTarget - pos).Unit
        bodyVel.Velocity = dir * flySpeed
        bodyGyro.CFrame = CFrame.lookAt(pos, actualTarget)
        humanoid.Health = 0
        if (actualTarget - pos).Magnitude < 3 then arrived = true break end
        RunService.RenderStepped:Wait()
    end
    bodyVel:Destroy()
    bodyGyro:Destroy()
    if landOnArrival then
        rootPart.CFrame = CFrame.new(targetPos)
    else
        rootPart.CFrame = CFrame.new(actualTarget)
    end
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    humanoid.PlatformStand = false
    if isNightTime() then return false end
    return true
end

local function getNearestSafePos(currentPos)
    local dist1 = (SAFE_POS_1 - currentPos).Magnitude
    local dist2 = (SAFE_POS_2 - currentPos).Magnitude
    return dist1 <= dist2 and SAFE_POS_1 or SAFE_POS_2
end

local function getNearestStartPos(currentPos)
    local dist1 = (START_POS_1 - currentPos).Magnitude
    local dist2 = (START_POS_2 - currentPos).Magnitude
    return dist1 <= dist2 and START_POS_1 or START_POS_2
end

