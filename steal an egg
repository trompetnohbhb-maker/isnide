local function getMutationMultiplier(mutations)
    local total = 1
    if type(mutations) == "table" then
        for _, m in ipairs(mutations) do
            local mult = MutationMultipliers[m] or 1
            if mult > 1 then total = total + (mult - 1) end
        end
    end
    return total
end

local function formatCompact(num)
    if num >= 1e12 then return string.format("%.2fT", num / 1e12)
    elseif num >= 1e9 then return string.format("%.2fB", num / 1e9)
    elseif num >= 1e6 then return string.format("%.2fM", num / 1e6)
    elseif num >= 1e3 then return string.format("%.1fK", num / 1e3)
    else return tostring(math.floor(num + 0.5)) end
end

local function formatScale(s)
    if math.abs(s - math.floor(s + 0.5)) < 0.001 then return tostring(math.floor(s + 0.5)) else return string.format("%.2f", s) end
end

local function parseIncomeText(text)
    text = tostring(text):gsub("%s+", ""):lower()
    if text == "" then return nil end
    local num, suffix = text:match("^([%d%.]+)([kmbt]?)$")
    if not num then return tonumber(text) end
    local value = tonumber(num)
    if not value then return nil end
    local multipliers = { k = 1e3, m = 1e6, b = 1e9, t = 1e12 }
    local mult = multipliers[suffix] or 1
    return value * mult
end

local function buildEggNameOptions()
    local seen = {}
    eggNameOptions = {}
    local tempList = {}
    for category, cfg in pairs(AssetsDirectory) do
        local optionString = cfg.DisplayName .. " | " .. cfg.Rarity
        if not seen[optionString] then
            seen[optionString] = true
            local idx = 99
            for i, r in ipairs(rarityOptions) do if r == cfg.Rarity then idx = i break end end
            table.insert(tempList, { optionString = optionString, rarityIndex = idx })
        end
    end
    table.sort(tempList, function(a, b) return a.rarityIndex < b.rarityIndex end)
    for _, item in ipairs(tempList) do table.insert(eggNameOptions, item.optionString) end
end
buildEggNameOptions()

