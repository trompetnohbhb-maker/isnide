local flySpeed = 1100

local function flyToTarget(targetPos)
    local rootPart = getRootPart()
    local humanoid = getHumanoid()
    if not rootPart or not humanoid or not rootPart.Parent then return false end

    humanoid.PlatformStand = true

    local targetY = targetPos.Y + 10
    local actualTarget = Vector3.new(targetPos.X, targetY, targetPos.Z)

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    bodyGyro.P = 10000
    bodyGyro.D = 100
    bodyGyro.CFrame = CFrame.lookAt(rootPart.Position, actualTarget)
    bodyGyro.Parent = rootPart

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Velocity = Vector3.new(0, 0, 0)
    bodyVel.Parent = rootPart

    local arrived = false
    local startTime = tick()

    while not arrived and (tick() - startTime) < 60 do
        if not rootPart.Parent then break end
        
        if isNightTime() then
            break
        end

        local pos = rootPart.Position
        local dir = (actualTarget - pos).Unit
        bodyVel.Velocity = dir * flySpeed
        bodyGyro.CFrame = CFrame.lookAt(pos, actualTarget)
        humanoid.Health = 0
        if (actualTarget - pos).Magnitude < 3 then
            arrived = true
            break
        end
        RunService.RenderStepped:Wait()
    end

    bodyVel:Destroy()
    bodyGyro:Destroy()
    rootPart.CFrame = CFrame.new(actualTarget)
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    humanoid.PlatformStand = false
    
    if isNightTime() then
        return false
    end
    return true
end

local function getNearestSafePos(currentPos)
    local dist1 = (SAFE_POS_1 - currentPos).Magnitude
    local dist2 = (SAFE_POS_2 - currentPos).Magnitude
    return dist1 <= dist2 and SAFE_POS_1 or SAFE_POS_2
end

local function getNearestStartPos(currentPos)
    local dist1 = (START_POS_1 - currentPos).Magnitude
    local dist2 = (START_POS_2 - currentPos).Magnitude
    return dist1 <= dist2 and START_POS_1 or START_POS_2
end

local farmDelay = 0.5
local farmActive = false
local farmLoop = nil

local function stopFarm()
    farmActive = false
    farmLoop = nil
end

local function startFarm()
    if farmActive then return end
    if #selectedAreasOrdered == 0 then return end

    farmActive = true

    enableGodMode()
    toggleDeathHandler(true)

    local rootPart = getRootPart()
    if rootPart then
        local startPos = getNearestStartPos(rootPart.Position)
        rootPart.CFrame = CFrame.new(startPos)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end

    wait(0.5)

    farmLoop = task.spawn(function()
        local waitedForDay = false
        while farmActive do
            local isNight = isNightTime()

            if isNight then
                waitedForDay = true
                while farmActive and isNightTime() do
                    task.wait(0.5)
                end
                task.wait(4)
                waitedForDay = false
            else
                if waitedForDay then
                    task.wait(4)
                    waitedForDay = false
                end

                local remaining = getRemainingSecondsToTransition()
                if remaining and remaining <= 15 then
                    local safePos = getNearestSafePos(getRootPart() and getRootPart().Position or SAFE_POS_1)
                    flyToTarget(safePos)
                    wait(0.5)

                    while farmActive and isNightTime() do
                        task.wait(0.5)
                    end

                    task.wait(4)
                    waitedForDay = false
                end

                local targetArea, models = findEggsFromSnapshot()
                if targetArea and #models > 0 then
                    local targetModel = models[math.random(1, #models)]
                    local targetUid = targetModel.Name
                    local targetPos = targetModel:IsA("Model") and targetModel:GetPivot().Position or targetModel.Position
                    
                    local flySuccess = flyToTarget(targetPos)

                    if not farmActive then break end

                    if not flySuccess and isNightTime() then
                        while farmActive and isNightTime() do
                            task.wait(0.5)
                        end
                        task.wait(4)
                        waitedForDay = false
                    elseif flySuccess and farmActive then
                        task.wait(0.2)

                        if carryRemote then
                            pcall(function() carryRemote:InvokeServer({ Uid = targetUid }) end)
                        else
                            stopFarm()
                            break
                        end

                        local safePos = getNearestSafePos(getRootPart() and getRootPart().Position or SAFE_POS_1)
                        flyToTarget(safePos)
                        wait(farmDelay)
                    else
                        wait(0.5)
                    end
                else
                    wait(1)
                end
            end

            if not farmActive then break end
        end
        disableGodMode()
        toggleDeathHandler(false)
    end)
end

