local function getEggsFromRuntime()
    local eggs = {}
    if not runtimeSnapshotRemote or not runtimeSnapshotRemote:IsA("RemoteFunction") then return eggs end

    local ok, result = pcall(function() return runtimeSnapshotRemote:InvokeServer() end)
    if not ok or not result then return eggs end

    local records = nil
    if type(result) == "table" then
        for _, entry in ipairs(result) do
            if type(entry) == "table" and entry.OwnerUserId == player.UserId then
                records = entry.Records
                break
            end
        end
        if not records and result.Records then records = result.Records end
    end

    if not records or type(records) ~= "table" then return eggs end

    for uid, eggData in pairs(records) do
        if type(uid) == "string" and type(eggData) == "table" then
            if eggData.Placement == nil then
                local category = eggData.AssetCategory or eggData.Category or "Unknown"
                local rarity = "Unknown"
                if AssetsDirectory[category] then rarity = AssetsDirectory[category].Rarity end
                local displayName = eggData.DisplayName or eggData.EggDisplayName or category

                table.insert(eggs, {
                    name = displayName,
                    uid = uid,
                    category = category,
                    rarity = rarity,
                })
            end
        end
    end
    return eggs
end

local function equipEgg(uid)
    if equipRemote and equipRemote:IsA("RemoteFunction") then
        pcall(function() equipRemote:InvokeServer(uid) end)
    elseif equipRemote and equipRemote:IsA("RemoteEvent") then
        pcall(function() equipRemote:FireServer(uid) end)
    end
end

local function isToolHeld(uid)
    local char = player.Character
    if not char then return false end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local attrUID = tool:GetAttribute("UID") or tool.Name
            if attrUID == uid then return true end
        end
    end
    return false
end

local function waitForToolHeld(uid, timeout)
    local start = tick()
    while tick() - start < timeout do
        if isToolHeld(uid) then return true end
        wait(0.1)
    end
    return false
end

local function sellEgg(uid)
    if not sellRemote then return false end
    pcall(function() sellRemote:FireServer({ uid }) end)
    return true
end

local function processInventory()
    local eggs = getEggsFromRuntime()
    if #eggs == 0 then
        safeSetLabel(sellStatusLabel, "Status: Tidak ada telur di inventory")
        return
    end

    local hasFilter = false
    for _, v in pairs(selectedSellRarities) do
        if v == true then hasFilter = true break end
    end

    local soldCount = 0
    local skippedCount = 0

    for _, egg in ipairs(eggs) do
        if isDestroyed then break end

        local shouldSell = true
        if hasFilter then shouldSell = selectedSellRarities[egg.rarity] == true end

        if shouldSell then
            safeSetLabel(sellStatusLabel, "Status: Equipping " .. egg.name)
            equipEgg(egg.uid)

            local held = waitForToolHeld(egg.uid, 3)
            if not held then
                safeSetLabel(sellStatusLabel, "Status: Gagal memegang " .. egg.name)
                skippedCount += 1
            else
                sellEgg(egg.uid)
                soldCount += 1
                safeSetLabel(sellStatusLabel, "Status: Sold " .. soldCount .. ": " .. egg.name)
            end

            wait(0.5)
        else
            skippedCount += 1
        end
    end

    safeSetLabel(sellStatusLabel, "Status: Selesai: " .. soldCount .. " terjual, " .. skippedCount .. " dilewati")
end

local espEnabled = false
local espRenderDistance = 50
local espDrawings = {}
local espLastScan = 0
local espStatusLabel = nil

local function espClearDrawings()
    for _, entry in ipairs(espDrawings) do pcall(function() entry.drawing:Remove() end) end
    espDrawings = {}
end

local function espGetEggPosition(record)
    if record.BottomCFrame then return record.BottomCFrame.Position end
    if record.Placement and record.Placement.LocalCFrame then return record.Placement.LocalCFrame.Position end
    return nil
end

local function espRefresh()
    espClearDrawings()
    local snapshot = getAreaEggSnapshot()
    if not snapshot or not snapshot.Records then
        safeSetLabel(espStatusLabel, "Eggs: 0")
        return
    end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        safeSetLabel(espStatusLabel, "Eggs: 0")
        return
    end
    local playerPos = char.HumanoidRootPart.Position
    local shown = 0
    for _, record in ipairs(snapshot.Records) do
        local pos = espGetEggPosition(record)
        if pos and (pos - playerPos).Magnitude <= espRenderDistance then
            local category = record.AssetCategory or "Unknown"
            local displayName = getDisplayName(category)
            local rarityName = getRarityName(category)
            local color = getRarityColorByCategory(category)

            local scale = record.AssetScale
            local income = getIncomeForCategoryAndScale(category, scale)

            local label = displayName .. " | " .. rarityName
            if scale and type(scale) == "number" then
                label = label .. " | Scale: " .. string.format("%.2f", scale)
            end
            label = label .. " | Income: " .. formatCompact(income)

            table.insert(espDrawings, {
                drawing = nil,
                label = label,
                color = color,
                pos = pos,
            })
            shown += 1
        end
    end
    for i, entry in ipairs(espDrawings) do
        pcall(function()
            local text = Drawing.new("Text")
            text.Text = entry.label
            text.Size = 16
            text.Color = entry.color
            text.Center = true
            text.Outline = true
            text.Visible = false
            espDrawings[i].drawing = text
        end)
    end
    safeSetLabel(espStatusLabel, "Eggs: " .. shown)
end

local function espUpdateDrawings()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    for _, entry in ipairs(espDrawings) do
        if entry.drawing then
            local screenPos, onScreen = camera:WorldToViewportPoint(entry.pos)
            if onScreen then
                entry.drawing.Visible = true
                entry.drawing.Position = Vector2.new(screenPos.X, screenPos.Y)
            else
                entry.drawing.Visible = false
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then
        if #espDrawings > 0 then espClearDrawings() end
        return
    end
    if os.clock() - espLastScan >= 1 then
        espLastScan = os.clock()
        espRefresh()
    end
    espUpdateDrawings()
end)

