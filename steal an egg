end

local function isModelAllowed(assetCategory)
    local rarityName = getRarityName(assetCategory)
    local displayName = getDisplayName(assetCategory)
    local hasNameSelection = false
    for _, v in pairs(selectedEggNames) do if v == true then hasNameSelection = true break end end
    local hasRaritySelection = false
    for _, v in pairs(selectedRarities) do if v == true then hasRaritySelection = true break end end
    local nameMatch = false
    if hasNameSelection then
        local optionString = displayName .. " | " .. rarityName
        nameMatch = selectedEggNames[optionString] == true
    end
    local rarityMatch = true
    if hasRaritySelection then rarityMatch = selectedRarities[rarityName] == true end
    if hasNameSelection then
        if nameMatch then return true end
        return rarityMatch
    else
        return rarityMatch
    end
end

local function getIncomeForCategoryScaleAndMutations(category, scale, mutations)
    local baseEarning = AssetsDirectory[category] and AssetsDirectory[category].EarningRate or 0
    local mutationMult = getMutationMultiplier(mutations or {})
    local safeScale = scale or 1
    return baseEarning * safeScale * mutationMult
end

local function findEggsFromSnapshot()
    local snapshot = getAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil, {} end
    local foundArea = nil
    local foundModels = {}
    for _, record in ipairs(snapshot.Records) do
        local recordArea = record.AreaId
        local area = nil
        for _, a in ipairs(selectedAreasOrdered) do if a.name == recordArea then area = a break end end
        if area then
            local uid = record.Uid
            local model = nil
            local folder = Workspace:FindFirstChild("AreaEggSlotsClient")
            if folder then model = folder:FindFirstChild(uid) end
            if not model then model = Workspace:FindFirstChild(uid) end
            if model and (model:IsA("Model") or model:IsA("BasePart")) then
                local assetCategory = record.AssetCategory or model.Name
                if isModelAllowed(assetCategory) then
                    local scale = record.AssetScale or model:GetAttribute("AssetScale") or 1
                    if model:IsA("Model") and model:GetScale() then scale = model:GetScale() end
                    local mutations = record.Mutations or {}
                    local income = getIncomeForCategoryScaleAndMutations(assetCategory, scale, mutations)
                    if income >= minIncomeFilter and income <= maxIncomeFilter and scale >= minScaleFilter and scale <= maxScaleFilter then
                        foundArea = area
                        table.insert(foundModels, model)
                    end
                end
            end
        end
    end
    return foundArea, foundModels
end

