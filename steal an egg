local function isNightFallback()
    local clock = Lighting.ClockTime
    local brightness = Lighting.Brightness
    local nightClockTime = 3.1
    local nightBrightness = 3
    local nearClock = math.abs(clock - nightClockTime) < 0.7
    local nearBrightness = (type(brightness) == "number") and math.abs(brightness - nightBrightness) < 0.2 or false
    return nearClock and nearBrightness
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then
        return string.format("%d jam %d mnt %d dtk", hours, minutes, secs)
    elseif minutes > 0 then
        return string.format("%d mnt %d dtk", minutes, secs)
    else
        return string.format("%d dtk", secs)
    end
end

local function getNightStatus()
    local now = Workspace:GetServerTimeNow()
    local isNight = false
    local timerText = "Mencari event..."
    local targetText = ""
    local demonic = Workspace:GetAttribute("Event_DemonicEvent") or false

    if nextResetAt and now < nextResetAt then
        isNight = true
        local remaining = nextResetAt - now
        timerText = formatTime(remaining)
        targetText = "Menuju: Siang ☀️"
        return isNight, timerText, targetText, demonic
    end

    local guiText = getGameResetTimerText() or getResetStartTimerText()
    if guiText then
        isNight = isNightFallback()
        timerText = guiText
        if isNight then
            targetText = "Menuju: Siang ☀️"
        else
            targetText = "Menuju: Malam 🌙"
        end
        return isNight, timerText, targetText, demonic
    end

    isNight = isNightFallback()
    if isNight then
        timerText = "Malam"
        targetText = "Menuju: Siang ☀️"
    else
        timerText = "Siang"
        targetText = "Menuju: Malam 🌙"
    end
    return isNight, timerText, targetText, demonic
end

local function isNightTime()
