local function processInventory()
    local eggs = getEggsFromRuntime()
    if #eggs == 0 then safeSetLabel(sellStatusLabel, "Status: Tidak ada telur di inventory") return end
    local hasFilter = false
    for _, v in pairs(selectedSellRarities) do if v == true then hasFilter = true break end end
    local soldCount = 0
    local skippedCount = 0
    for _, egg in ipairs(eggs) do
        if isDestroyed then break end
        local shouldSell = true
        if hasFilter then shouldSell = selectedSellRarities[egg.rarity] == true end
        if shouldSell then
            safeSetLabel(sellStatusLabel, "Status: Equipping " .. egg.name)
            equipEgg(egg.uid)
            local held = waitForToolHeld(egg.uid, 3)
            if not held then
                safeSetLabel(sellStatusLabel, "Status: Gagal memegang " .. egg.name)
                skippedCount = skippedCount + 1
            else
                sellEgg(egg.uid)
                soldCount = soldCount + 1
                safeSetLabel(sellStatusLabel, "Status: Sold " .. soldCount .. ": " .. egg.name)
            end
            wait(0.5)
        else
            skippedCount = skippedCount + 1
        end
    end
    safeSetLabel(sellStatusLabel, "Status: Selesai: " .. soldCount .. " terjual, " .. skippedCount .. " dilewati")
end

