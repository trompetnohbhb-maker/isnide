local NameFilterGroup = TabHome:AddLeftGroupbox("Name Filter")
local IncomeFilterGroup = TabHome:AddLeftGroupbox("Income Filter")
local ScaleFilterGroup = TabHome:AddLeftGroupbox("Scale Filter")

timeStatusLabel = TimeInfoGroup:AddLabel("Kondisi: Memuat...")
durationStatusLabel = TimeInfoGroup:AddLabel("Sisa Waktu: Memuat...")

elementIdx = elementIdx + 1
AreaGroup.AddDropdown(AreaGroup, elementIdx, {
    Text = "Select Area (Priority)",
    Values = areaNames,
    Multi = true,
    AllowNull = true,
    Default = {},
    Callback = function(selected)
        selectedAreasSet = {}
        selectedAreasOrdered = {}
        local anySelected = false
        for name, enabled in pairs(selected) do
            selectedAreasSet[name] = enabled
            if enabled then anySelected = true end
        end
        if not anySelected then
            for _, a in ipairs(areas) do selectedAreasSet[a.name] = true end
            for i = #areas, 1, -1 do table.insert(selectedAreasOrdered, areas[i]) end
        else
            for i = #areas, 1, -1 do
                local area = areas[i]
                if selectedAreasSet[area.name] then table.insert(selectedAreasOrdered, area) end
            end
        end
    end,
})

elementIdx = elementIdx + 1
RarityFilterGroup.AddDropdown(RarityFilterGroup, elementIdx, {
    Text = "Select Rarity (Optional)",
    Values = rarityOptions,
    Multi = true,
    AllowNull = true,
    Default = {},
    Callback = function(selected) selectedRarities = selected end,
})

elementIdx = elementIdx + 1
NameFilterGroup.AddDropdown(NameFilterGroup, elementIdx, {
    Text = "Select Egg Name (Priority)",
    Values = eggNameOptions,
    Multi = true,
    AllowNull = true,
    Default = {},
    Callback = function(selected) selectedEggNames = selected end,
})

elementIdx = elementIdx + 1
IncomeFilterGroup.AddInput(IncomeFilterGroup, elementIdx, {
    Text = "Min Income (ex: 1K, 1M)",
    Default = "0",
    ClearTextOnFocus = false,
    Finished = true,
    Callback = function(value)
        local parsed = parseIncomeText(value)
        if parsed then minIncomeFilter = parsed end
    end,
})

elementIdx = elementIdx + 1
IncomeFilterGroup.AddInput(IncomeFilterGroup, elementIdx, {
    Text = "Max Income (kosong = ∞)",
    Default = "",
    ClearTextOnFocus = false,
    Finished = true,
    Callback = function(value)
        if value == "" then maxIncomeFilter = math.huge else
            local parsed = parseIncomeText(value)
            if parsed then maxIncomeFilter = parsed end
        end
    end,
})

elementIdx = elementIdx + 1
ScaleFilterGroup.AddSlider(ScaleFilterGroup, elementIdx, {
    Text = "Min Scale",
    Min = 0.1,
    Max = 100,
    Default = 0.1,
    Rounding = 2,
    Suffix = "x",
    Callback = function(value) minScaleFilter = value end,
})

elementIdx = elementIdx + 1
ScaleFilterGroup.AddSlider(ScaleFilterGroup, elementIdx, {
    Text = "Max Scale",
    Min = 0.1,
    Max = 100,
    Default = 100,
    Rounding = 2,
    Suffix = "x",
    Callback = function(value) maxScaleFilter = value end,
})

elementIdx = elementIdx + 1
AutoFarmGroup.AddToggle(AutoFarmGroup, elementIdx, {
    Text = "Start Auto Farm",
    Default = false,
    Callback = function(state)
        if state then startFarm() else stopFarm() end
    end,
})

elementIdx = elementIdx + 1
AutoFarmGroup.AddInput(AutoFarmGroup, elementIdx, {
    Text = "Farm Delay (seconds)",
    Default = tostring(farmDelay),
    Numeric = true,
    ClearTextOnFocus = false,
    Finished = true,
    Callback = function(value) farmDelay = tonumber(value) or 0.5 end,
})

elementIdx = elementIdx + 1
AutoFarmGroup.AddInput(AutoFarmGroup, elementIdx, {
    Text = "Fly Speed",
    Default = tostring(flySpeed),
    Numeric = true,
    ClearTextOnFocus = false,
    Finished = true,
    Callback = function(value)
        local newSpeed = tonumber(value)
        if newSpeed and newSpeed > 0 then flySpeed = newSpeed end
    end,
})

local SellLeft = TabSell:AddLeftGroupbox("Auto Sell")
sellStatusLabel = SellLeft:AddLabel("Status: Idle")

elementIdx = elementIdx + 1
SellLeft.AddDropdown(SellLeft, elementIdx, {
    Text = "Sell Rarity Filter",
    Values = rarityOptions,
    Multi = true,
    AllowNull = true,
    Default = {},
    Callback = function(selected) selectedSellRarities = selected end,
})

SellLeft:AddButton({
    Text = "Scan Eggs",
    Callback = function()
        local eggs = getEggsFromRuntime()
        if #eggs == 0 then safeSetLabel(sellStatusLabel, "Status: Tidak ada telur di inventory")
        else safeSetLabel(sellStatusLabel, "Status: Ditemukan " .. #eggs .. " telur") end
    end,
})

SellLeft:AddButton({
    Text = "Sell Eggs (Filtered)",
    Callback = function() processInventory() end,
})

local ESPLeft = TabESP:AddLeftGroupbox("ESP Settings")
espStatusLabel = ESPLeft:AddLabel("Eggs: 0")

elementIdx = elementIdx + 1
ESPLeft.AddToggle(ESPLeft, elementIdx, {
    Text = "Enable ESP",
    Default = false,
    Callback = function(state)
        espEnabled = state
        if state then espLastScan = 0 else
            espClearDrawings()
            safeSetLabel(espStatusLabel, "Eggs: 0")
        end
    end,
})

elementIdx = elementIdx + 1
ESPLeft.AddSlider(ESPLeft, elementIdx, {
    Text = "Render Distance",
    Min = 1,
    Max = 10000,
    Default = 50,
    Rounding = 0,
    Suffix = " studs",
    Callback = function(value)
        espRenderDistance = value
        if espEnabled then espLastScan = 0 end
    end,
})

local DangerGroup = TabSell:AddRightGroupbox("Danger")
DangerGroup:AddButton({
    Text = "Destroy UI",
    Risky = true,
    Callback = function()
        isDestroyed = true
        stopFarm()
        espEnabled = false
        espClearDrawings()
        wait(0.5)
        Library:Unload()
    end,
})

local ToggleBtn = Library:AddDraggableButton("Show/Hide", function() Library:Toggle() end, true, true)
local LockBtn = Library:AddDraggableButton("Lock", function(btn)
    Library.CantDragForced = not Library.CantDragForced
    btn:SetText(Library.CantDragForced and "Unlock" or "Lock")
end, true, true)
ToggleBtn.Button.Position = UDim2.fromOffset(6, 6)
LockBtn.Button.Position = UDim2.fromOffset(ToggleBtn.Button.Size.X.Offset + 12, 6)

Library:Notify({
    Title = "Yuta Hub",
    Description = "Steal an egg script",
    Time = 5,
})
